---
import { site } from "../site.config";
const links = [
  { href: "/projekt", label: "Projekt" },
  { href: "/tjanster", label: "Tjänster" },
  { href: "/om", label: "Om" },
  { href: "/kontakt", label: "Kontakt" },
];
const path = Astro.url.pathname;
---

<header class="relative bg-cream">
  <div class="max-w-6xl mx-auto px-6 py-8 flex items-center justify-between gap-6">
    <a href="/" class="block">
      <p class="font-display text-2xl md:text-3xl text-chocolate leading-none">
        {site.name}
      </p>
      <p class="font-mono text-[10px] uppercase tracking-[0.25em] text-oak mt-1">
        / Sollentuna, sedan {site.yearStarted}
      </p>
    </a>
    <nav class="hidden md:flex items-center gap-7 font-display text-base italic text-chocolate-soft">
      {
        links.map(({ href, label }) => (
          <a
            href={href}
            class:list={[
              "hover:text-amber transition-colors",
              path === href && "text-chocolate font-medium not-italic",
            ]}
          >
            {label}
          </a>
        ))
      }
    </nav>
    <a
      href="/offert"
      class="hidden sm:inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-chocolate hover:text-amber transition-colors"
    >
      Be om offert
      <span class="inline-block w-8 h-px bg-current"></span>
    </a>
  </div>
  <div class="h-px bg-line max-w-6xl mx-auto"></div>
</header>
