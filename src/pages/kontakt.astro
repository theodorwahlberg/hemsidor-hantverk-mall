---
import Base from "../layouts/Base.astro";
import { site } from "../site.config";
---

<Base title={`Kontakt — ${site.name}`}>
  <section class="max-w-6xl mx-auto px-6 pt-20 md:pt-28 pb-24">
    <p class="plate-num">/ Vol. 05 · Kontakt</p>
    <h1 class="font-display text-[clamp(3rem,7vw,6rem)] text-chocolate mt-6 leading-[0.95]">
      Hör av <span class="italic text-amber">er.</span>
    </h1>

    <div class="editorial-divider mt-20"><span>❦</span></div>

    <div class="grid md:grid-cols-12 gap-10 md:gap-16 mt-16">
      <div class="md:col-span-7 space-y-12">
        <div>
          <p class="plate-num">/ Telefon</p>
          <a
            href={`tel:${site.phone.replace(/\s/g, "")}`}
            class="font-display text-5xl md:text-7xl text-chocolate hover:text-amber transition-colors block mt-3 leading-none"
          >
            {site.phone}
          </a>
          <p class="font-display italic text-chocolate-soft mt-3">
            Snabbast på vardagar, 9–16.
          </p>
        </div>

        <div>
          <p class="plate-num">/ E-post</p>
          <a
            href={`mailto:${site.email}`}
            class="font-display text-3xl md:text-5xl italic text-chocolate hover:text-amber transition-colors block mt-3 break-all"
          >
            {site.email}
          </a>
        </div>

        <div>
          <p class="plate-num">/ Verkstaden</p>
          <p class="font-display text-3xl text-chocolate mt-3 leading-tight">
            {site.address.street}<br />
            {site.address.postal}
          </p>
          <a
            href={site.address.mapsUrl}
            target="_blank"
            rel="noopener"
            class="inline-block mt-4 font-display italic text-amber hover:text-amber-deep"
          >
            Karta →
          </a>
        </div>
      </div>

      <aside class="md:col-span-5">
        <div class="bg-cream-deep border border-line p-8 md:p-10">
          <p class="plate-num">/ Öppettider</p>
          <div class="mt-6 space-y-3 font-mono text-sm">
            {
              site.hours.map((h) => (
                <div class="flex justify-between border-b border-line/60 pb-2">
                  <span class="text-chocolate-soft uppercase tracking-wider text-[11px]">
                    {h.day}
                  </span>
                  <span class="text-chocolate tabular-nums">{h.time}</span>
                </div>
              ))
            }
          </div>
        </div>

        <a
          href="/offert"
          class="block mt-6 bg-chocolate text-cream p-8 hover:bg-amber transition-colors group"
        >
          <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-cream/70">
            / Snabbast
          </p>
          <p class="font-display text-3xl mt-3 leading-tight">
            Skicka offertförfrågan →
          </p>
          <p class="text-cream/75 text-sm mt-3 leading-relaxed">
            Beskriv jobbet, vi återkopplar inom 24 timmar.
          </p>
        </a>
      </aside>
    </div>
  </section>
</Base>
